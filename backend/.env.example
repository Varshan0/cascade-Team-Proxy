NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/multipli
REDIS_URL=redis://localhost:6379
# Comma-separated, tried in order (viem fallback). Keyless defaults verified 2026-09-19: publicnode resets Node TLS on some
# networks and caps history; 1rpc caps eth_getLogs at 50 blocks. Put an Alchemy/Infura URL first for deep backfills.
RPC_URLS=https://ethereum-rpc.publicnode.com,https://1rpc.io/eth,https://cloudflare-eth.com
RPC_WS_URL=                     # optional, for eth_subscribe
LIQ_BACKFILL_DAYS=30
LIQ_MIN_CHUNK=100              # lower (e.g. 25) for RPCs capped below 100 blocks per eth_getLogs
ORACLE_PRESSURE_GAP=-0.005     # fast/Chainlink - 1 below this flags liquidation pressure
PYTH_API_KEY=                   # optional; Hermes returns 401 without it (verified 2026-09-19)
PYTH_BASE_URL=https://pyth.dourolabs.app/hermes
COINGECKO_API_KEY=              # demo key, optional
CMC_API_KEY=                    # optional
CRYPTOCOMPARE_API_KEY=          # optional
ETHERSCAN_API_KEY=              # optional
JWT_SECRET=dev-only-change-me-please
SIWE_DOMAIN=localhost:5173
CORS_ORIGINS=http://localhost:5173
DEMO_OFFLINE=false
SIM_SEED=42                     # offline simulator RNG seed
SIM_DROPS_PER_DAY=1.2           # sudden drops per day in the offline simulator
SEPOLIA_RPC_URL=                # P2 only
SEPOLIA_DEPLOYER_KEY=           # P2 only, testnet key, never mainnet
