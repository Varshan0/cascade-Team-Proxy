            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "cursor",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asOf": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "live",
                        "replay",
                        "drill",
                        "offline"
                      ]
                    },
                    "source": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "txHash": {
                            "type": "string"
                          },
                          "logIndex": {
                            "type": "number"
                          },
                          "blockNumber": {
                            "type": "number"
                          },
                          "ts": {
                            "type": "string"
                          },
                          "collateralAsset": {
                            "type": "string"
                          },
                          "collateralSymbol": {
                            "nullable": true,
                            "type": "string"
                          },
                          "debtAsset": {
                            "type": "string"
                          },
                          "debtSymbol": {
                            "nullable": true,
                            "type": "string"
                          },
                          "user": {
                            "type": "string"
