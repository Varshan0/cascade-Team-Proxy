                          "debtAmountRaw": {
                            "type": "string"
                          },
                          "collateralAmountRaw": {
                            "type": "string"
                          },
                          "usdValue": {
                            "nullable": true,
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "txUrl": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "txHash",
                          "logIndex",
                          "blockNumber",
                          "ts",
                          "collateralAsset",
                          "collateralSymbol",
                          "debtAsset",
                          "debtSymbol",
                          "user",
                          "liquidator",
                          "debtAmountRaw",
                          "collateralAmountRaw",
                          "usdValue",
                          "status",
                          "txUrl"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
