  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness: DB, Redis, and no failover chain fully down",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "chains": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "ok",
                              "degraded",
                              "down",
                              "unknown"
                            ]
                          },
                          "providers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "status",
                          "providers"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "status",
                    "checks",
                    "chains"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "not_ready"
                      ]
                    },
                    "checks": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "chains": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "ok",
                              "degraded",
                              "down",
                              "unknown"
                            ]
                          },
                          "providers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "status",
                          "providers"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "status",
                    "checks",
                    "chains"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health/providers": {
      "get": {
        "summary": "Per-provider status table (drives the frontend \"data sources\" indicator)",
        "tags": [
          "ops"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asOf": {
                      "type": "string"
                    },
                    "providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "ok",
                              "degraded",
                              "down",
                              "unknown"
                            ]
                          },
                          "circuit": {
                            "type": "string",
                            "enum": [
                              "closed",
                              "open",
                              "half-open"
                            ]
                          },
                          "lastSuccess": {
                            "nullable": true,
                            "type": "string"
                          },
                          "lastError": {
                            "nullable": true,
                            "type": "string"
                          },
                          "lastErrorMessage": {
                            "nullable": true,
                            "type": "string"
                          },
                          "p95LatencyMs": {
                            "nullable": true,
                            "type": "number"
                          },
                          "successCount": {
                            "type": "number"
                          },
                          "errorCount": {
                            "type": "number"
                          },
                          "quotaRemaining": {
                            "nullable": true,
                            "type": "number"
                          },
                          "reportedAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "status",
                          "circuit",
                          "lastSuccess",
                          "lastError",
                          "lastErrorMessage",
                          "p95LatencyMs",
                          "successCount",
                          "errorCount",
                          "quotaRemaining"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "chains": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "status": {
                            "type": "string",
                            "enum": [
                              "ok",
                              "degraded",
                              "down",
                              "unknown"
                            ]
                          },
                          "providers": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "status",
                          "providers"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "suspectTicks": {
                      "type": "object",
                      "properties": {
                        "total": {
                          "type": "number"
                        },
                        "recent": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": {}
                          }
                        }
                      },
                      "required": [
                        "total",
                        "recent"
                      ],
                      "additionalProperties": false
                    },
                    "indexer": {
                      "nullable": true,
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "asOf",
                    "providers",
                    "chains",
                    "suspectTicks",
                    "indexer"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
