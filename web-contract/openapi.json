    "/api/v1/oracle/{symbol}": {
      "get": {
        "summary": "Chainlink price (what Aave liquidates on) vs the fast market price, and the gap between them",
        "tags": [
          "liquidations"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]+-[A-Z]+$"
            },
            "in": "path",
            "name": "symbol",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asOf": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "live",
                        "replay",
                        "drill",
                        "offline"
                      ]
                    },
                    "source": {
                      "type": "string"
                    },
                    "oracle": {
                      "type": "object",
                      "properties": {
                        "symbol": {
                          "type": "string"
                        },
                        "chainlinkPrice": {
                          "type": "string"
                        },
                        "fastPrice": {
                          "nullable": true,
                          "type": "string"
                        },
                        "gap": {
                          "nullable": true,
                          "type": "string"
                        },
                        "pressure": {
                          "type": "boolean"
                        },
                        "roundId": {
                          "type": "string"
                        },
                        "updatedAt": {
                          "type": "string"
                        },
                        "ageSec": {
                          "type": "number"
                        },
                        "heartbeatSec": {
                          "type": "number"
                        },
                        "deviation": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "symbol",
                        "chainlinkPrice",
                        "fastPrice",
                        "gap",
                        "pressure",
                        "roundId",
                        "updatedAt",
                        "ageSec",
                        "heartbeatSec",
                        "deviation"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "asOf",
                    "mode",
                    "source",
                    "oracle"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals/state": {
      "get": {
        "summary": "Current Cascade Catcher state, meters and reason (the drill's synthetic state while a drill runs)",
        "tags": [
          "signals"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asOf": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "live",
                        "replay",
                        "drill",
                        "offline"
                      ]
                    },
                    "source": {
                      "type": "string"
                    },
                    "synthetic": {
                      "type": "boolean"
                    },
                    "drillActive": {
                      "type": "boolean"
                    },
                    "state": {
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "asOf",
                    "mode",
                    "source",
                    "synthetic",
                    "drillActive",
                    "state"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/signals/history": {
      "get": {
        "summary": "State transitions (live engine only; drills are never recorded)",
        "tags": [
          "signals"
        ],
        "parameters": [
          {
            "schema": {
              "default": 50,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "in": "query",
            "name": "cursor",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "asOf": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "live",
                        "replay",
                        "drill",
                        "offline"
                      ]
                    },
                    "source": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "ts": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string"
                          },
                          "mode": {
                            "type": "string"
                          },
                          "payload": {}
                        },
                        "required": [
                          "id",
                          "ts",
                          "state",
                          "mode",
                          "payload"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
                      "type": "number"
                    }
                  },
                  "required": [
                    "asOf",
                    "mode",
                    "source",
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
